  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "elysia": "^1.4.23",
    "prisma": "^7.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
